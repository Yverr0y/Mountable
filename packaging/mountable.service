[Unit]
Description=Mountable USB image service
After=sys-kernel-config.mount
Wants=sys-kernel-config.mount

[Service]
Type=simple
Environment=PYTHONPATH=/opt/mountable PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m mountable.daemon
RuntimeDirectory=mountable
# A mounted image lives in the kernel and survives a service restart; keep the
# record of what was paused for it so unmount can still restore it.
RuntimeDirectoryPreserve=yes
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
