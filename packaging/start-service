#!/bin/sh
# Starts the Mountable service. The app runs this through sudo when the
# service is not running, after asking for the device password.
set -eu

UNIT=mountable.service

# The full build ships the unit (and normally has it running already). This
# also covers a service that was started from the app and is still up.
if systemctl cat "$UNIT" >/dev/null 2>&1; then
    exec systemctl start "$UNIT"
fi

# Otherwise run it for as long as it is needed: it stops by itself once the
# app has closed and nothing is mounted or downloading.
exec systemd-run --quiet --collect --unit="$UNIT" \
    --description="Mountable USB image service" \
    -p RuntimeDirectory=mountable -p RuntimeDirectoryPreserve=yes \
    -E PYTHONPATH=/usr/lib/mountable -E PYTHONUNBUFFERED=1 \
    /usr/bin/python3 -m mountable.daemon --exit-when-idle
