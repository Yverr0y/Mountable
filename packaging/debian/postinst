#!/bin/sh
set -e

UNIT=mountable.service

if [ "$1" = configure ]; then
    python3 -m compileall -q /usr/lib/mountable >/dev/null 2>&1 || true
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        if [ -e "/usr/lib/systemd/system/$UNIT" ]; then
            # Full build: the service runs all the time. A mounted image
            # stays mounted across the restart.
            systemctl enable "$UNIT" >/dev/null 2>&1 || true
            systemctl restart "$UNIT" || true
        else
            # Store build: the app starts the service when it opens. Stop one
            # left running by the previous version so the new code is used.
            systemctl disable "$UNIT" >/dev/null 2>&1 || true
            systemctl stop "$UNIT" >/dev/null 2>&1 || true
        fi
    fi
fi
exit 0
